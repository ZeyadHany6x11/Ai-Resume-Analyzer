RESUME_ANALYZER_APP_NAME="AI Resume Analyzer"
RESUME_ANALYZER_ENVIRONMENT=local
RESUME_ANALYZER_LOG_LEVEL=INFO
RESUME_ANALYZER_DATABASE_PATH=resume_analyzer.db
RESUME_ANALYZER_EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
RESUME_ANALYZER_CACHE_ENABLED=true
RESUME_ANALYZER_CACHE_TTL_SECONDS=3600
RESUME_ANALYZER_SEMANTIC_WEIGHT=0.6
RESUME_ANALYZER_SKILL_WEIGHT=0.4
RESUME_ANALYZER_MAX_UPLOAD_SIZE_MB=10
RESUME_ANALYZER_JOB_MAX_RETRIES=2
RESUME_ANALYZER_JOB_TIMEOUT_SECONDS=120
RESUME_ANALYZER_STALE_JOB_AGE_SECONDS=3600
